{
  "name": "nature-forward-therapy",
  "version": "0.1.0",
  "private": true,
  "description": "Nature-Forward Therapy – Next.js + RBAC CMS",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
